# ---------------------------------------------------------------------------
# Copy to .env and fill in AT LEAST ONE provider key.
# The waterfall skips any provider whose key is blank, so a single key works.
# ---------------------------------------------------------------------------

PORT=8787
NODE_ENV=development

# --- Provider credentials --------------------------------------------------
# 1st choice
ANTHROPIC_API_KEY=
# 2nd choice
GEMINI_API_KEY=
# Extra Gemini keys, comma-separated. The gateway rotates to the next key when
# one is quota-limited (429) or the model is overloaded (503) — free-tier
# quotas are per key, so several keys multiply your effective quota.
# GEMINI_API_KEYS=AIza...second,AIza...third
# 3rd choice
OPENAI_API_KEY=

# --- Model overrides (optional) --------------------------------------------
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GEMINI_MODEL=gemini-1.5-flash
OPENAI_MODEL=gpt-4o-mini

# --- API base URLs (optional) ----------------------------------------------
# Point a provider at a proxy, an Azure/Vertex-style endpoint, or a local mock.
# Leave unset to use the vendors' own hosts.
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# OPENAI_BASE_URL=https://api.openai.com

# --- Generation ------------------------------------------------------------
MAX_TOKENS=1024
TEMPERATURE=0.2

# --- Timeouts & loop -------------------------------------------------------
PROVIDER_TIMEOUT_MS=30000
TOOL_TIMEOUT_MS=20000
MAX_TOOL_ITERATIONS=6
HEARTBEAT_MS=15000

# --- Input limits ----------------------------------------------------------
MAX_MESSAGE_CHARS=4000
MAX_HISTORY_TURNS=12

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
TOOL_RATE_LIMIT_MAX=200

# --- CORS ------------------------------------------------------------------
ALLOWED_ORIGINS=https://www.abhibus.com,https://abhibus.com
# Development escape hatch. Never enable in production.
ALLOW_ALL_ORIGINS=false
